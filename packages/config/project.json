{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/config",
  "targets": {
    "install": {
      "executor": "@nxlv/python:install",
      "options": { "silent": false, "args": ["--sync"] }
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": ["{workspaceRoot}/packages/config/dist"],
      "options": { "outputPath": "{workspaceRoot}/packages/config/dist", "publish": false }
    }
  }
}
