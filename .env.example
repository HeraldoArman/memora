# Memora — environment configuration.
# Copy to apps/backend/.env (or repo root .env) and fill the required keys.
# Required keys with no value here will fail loudly at startup (pydantic-settings).

# === LiveKit (required) ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# === Gemini (required) ===
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_TEXT_MODEL=gemini-2.5-flash

# === Postgres (required) ===
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/memora

# === Neo4j (required) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memora123

# === FAISS ===
FAISS_INDEX_PATH=data/face_index.faiss
FACE_EMBEDDING_DIM=512
FACE_MATCH_THRESHOLD=0.80
FACE_POSSIBLE_MATCH_THRESHOLD=0.60

# === InsightFace ===
FACE_MODEL_ROOT=models/insightface

# === Perception ===
FRAME_SAMPLE_FPS=1.0
OBSERVATION_FUSION_WINDOW_MS=1000
OBSERVATION_TTL_MS=5000
MAX_CONTEXT_AGE_MS=30000

# === Reasoning ===
GEMINI_AUDIO_OUTPUT_SAMPLE_RATE=24000
GEMINI_AUDIO_OUTPUT_CHANNELS=1

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === Worker health check ===
WORKER_HEALTH_PORT=8001

# === Agent identity ===
# Defaults to memora-agent-<hostname>. Override with a custom name if needed.
# Must match AGENT_NAME in apps/dashboard/.env.
AGENT_NAME=memora-agent-myhostname