{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/firmware/main",
  "tags": ["firmware"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "idf.py -C apps/firmware build"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/firmware/build"],
      "options": {
        "command": "idf.py -C apps/firmware build"
      }
    },
    "upload": {
      "executor": "nx:run-commands",
      "options": {
        "command": "idf.py -C apps/firmware flash"
      }
    },
    "monitor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "idf.py -C apps/firmware monitor"
      }
    }
  }
}
