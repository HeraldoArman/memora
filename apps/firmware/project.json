{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/firmware/src",
  "tags": ["firmware"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pio run -d apps/firmware"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/firmware/.pio/build"],
      "options": {
        "command": "pio run -d apps/firmware"
      }
    },
    "upload": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pio run -d apps/firmware -t upload"
      }
    },
    "monitor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pio device monitor -d apps/firmware"
      }
    }
  }
}