# Memora dashboard — environment configuration.
# Copy to apps/dashboard/.env.local and fill with the SAME LiveKit keys the backend
# worker uses (apps/backend/.env). The /api/token route mints join tokens server-side;
# NEXT_PUBLIC_LIVEKIT_URL is exposed to the browser so the client knows where to connect.

# === LiveKit (server-side — used by /api/token to mint tokens) ===
LIVEKIT_URL=wss://meet-ai-2ryoqh05.livekit.cloud
LIVEKIT_API_KEY=APIWyXtvAv3TNpW
LIVEKIT_API_SECRET=RDxm5ijj21IfMeLTPTeGyffeemwDGYlSxpBmLyB7Ht8e

# === LiveKit (public — read by the browser to know the server address) ===
# Must match LIVEKIT_URL above.
NEXT_PUBLIC_LIVEKIT_URL=wss://meet-ai-2ryoqh05.livekit.cloud